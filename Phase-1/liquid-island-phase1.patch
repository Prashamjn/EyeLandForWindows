+.pl-cat:hover { color: var(--fg); background: var(--hover); } .pl-cat.on { background: var(--press); color: var(--fg); }
+.pl-grid { flex: 1; min-height: 0; overflow-y: auto; display: grid; grid-template-columns: repeat(5, 1fr); grid-auto-rows: 78px; gap: 6px; align-content: start; padding-right: 2px; }
+.pl-card { border-radius: 14px; background: var(--card); border: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 0 6px; color: var(--muted); font-size: 11px; font-weight: 600; text-align: center; line-height: 1.2; transition: background var(--t-ui), color var(--t-ui), border-color var(--t-ui), transform var(--t-ui); }
+.pl-card svg { width: 21px; height: 21px; }
