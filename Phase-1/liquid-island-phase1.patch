@@ -0,0 +1,110 @@
+/* Dashboard area: cards, nav, plugin navigation, panels (timer, clipboard, tasks, settings). */
+.card { border-radius: var(--r-card); background: var(--card); border: 1px solid var(--border); min-width: 0; min-height: 0; }
+.label { font-size: 11.5px; font-weight: 600; color: var(--muted); }
+.sub { font-size: 12px; color: var(--muted); }
+
+/* ---------- home: clock | weather / quick actions | controls ---------- */
+.home { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 8px; height: 100%; }
+
+.clock { display: flex; flex-direction: column; justify-content: space-between; padding: 12px 14px; position: relative; }
+.clock-time { font: 600 38px/1 var(--font-display); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
+.clock-ap { font-size: 13px; font-weight: 600; color: var(--muted); margin-left: 5px; letter-spacing: 0; }
+.clock-day { font-size: 13px; font-weight: 600; }
+.clock-date { font-size: 12px; color: var(--muted); }
+.clock-bat { position: absolute; top: 11px; right: 13px; display: flex; align-items: center; gap: 4px; font-size: 11.5px; font-weight: 600; color: var(--muted); }
+.clock-bat svg { width: 15px; height: 15px; }
+.clock-bat.charging { color: var(--success); }
+
+.wx { display: flex; flex-direction: column; justify-content: space-between; padding: 12px 14px; }
+.wx-top { display: flex; align-items: center; gap: 5px; min-width: 0; font-size: 12px; color: var(--muted); font-weight: 600; }
+.wx-top span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.wx-top svg { width: 13px; height: 13px; }
+.wx-main { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
+.wx-temp { font: 600 36px/1 var(--font-display); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
+.wx-glyph svg { width: 36px; height: 36px; stroke-width: 1.4; color: var(--fg); }
+.wx-bot { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--muted); }
+.wx-bot b { color: var(--fg); font-weight: 600; }
+.wx-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; text-align: center; color: var(--muted); font-size: 12px; padding: 0 4px; min-height: 0; }
+.wx-state svg { width: 20px; height: 20px; color: var(--faint); margin-bottom: 3px; }
+.wx-state .t { color: var(--fg); font-weight: 600; }
+.wx-state .link-btn { margin-top: 5px; color: var(--accent); font-weight: 600; } .wx-state .link-btn:hover { color: var(--accent); opacity: .8; }
+
+.qa { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 8px; }
+.qa-btn { border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: var(--muted); font-size: 11px; font-weight: 600; transition: background var(--t-ui), color var(--t-ui), transform var(--t-ui); }
+.qa-btn:hover { background: var(--hover); color: var(--fg); } .qa-btn:active { background: var(--press); transform: scale(.97); }
+.qa-btn svg { width: 20px; height: 20px; }
+.qa-btn.on { color: var(--accent); }
+
+.ctl { padding: 12px 14px; display: flex; flex-direction: column; justify-content: center; gap: 13px; }
+.ctl-row { display: flex; flex-direction: column; gap: 7px; }
+.ctl-top { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--muted); }
+.ctl-top .num { margin-left: auto; color: var(--fg); font-variant-numeric: tabular-nums; }
+.ctl-top svg { width: 16px; height: 16px; color: var(--fg); }
+input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 2px; min-width: 0; outline: none; background: linear-gradient(to right, var(--fg) var(--p, 50%), var(--track) var(--p, 50%)); }
+input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 13px; height: 13px; border-radius: 50%; background: var(--fg); border: 0; box-shadow: 0 1px 4px rgba(0, 0, 0, .4); }
+
+/* ---------- nav ---------- */
+.nav { flex: none; height: 34px; display: flex; justify-content: center; align-items: center; gap: 4px; }
+.nav button { position: relative; width: 46px; height: 30px; border-radius: 10px; display: grid; place-items: center; color: var(--muted); transition: background var(--t-ui), color var(--t-ui); }
+.nav button:hover { background: var(--hover); color: var(--fg); }
+.nav button.on { background: var(--press); color: var(--fg); }
+.nav button.on::after { content: ""; position: absolute; bottom: 2px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
+
+/* ---------- plugin navigation ---------- */
+.pl { display: flex; flex-direction: column; gap: 8px; height: 100%; }
+.pl-cats { display: flex; gap: 2px; flex: none; }
