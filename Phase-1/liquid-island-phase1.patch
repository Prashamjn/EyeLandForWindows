+      const changed = m.value !== sys.vol || m.muted !== sys.muted;
+      sys.vol = m.value; sys.muted = m.muted; paintSystem();
+      if (changed && !first.vol) LI.activity.show({ id: 'volume', kind: 'volume', icon: volIcon(m.value, m.muted), title: 'Volume', value: m.muted ? 'Muted' : m.value + '%', progress: m.muted ? 0 : m.value }, { ttl: ttl() });
+      first.vol = false;
+    } else if (m.kind === 'bri') {
+      if (m.value === null) { sys.bri = null; $('#briRow').hidden = true; return; }            // no brightness control on this display
+      const changed = m.value !== sys.bri;
+      sys.bri = m.value; paintSystem();
+      if (changed && !first.bri) LI.activity.show({ id: 'brightness', kind: 'brightness', icon: 'sun', title: 'Brightness', value: m.value + '%', progress: m.value }, { ttl: ttl() });
+      first.bri = false;
+    }
+  }
+
+  /* ================= quick actions (only things that really work today) ================= */
+  const quick = $('#quick');
+  const QA = [
+    { id: 'mute', label: () => (sys.muted ? 'Unmute' : 'Mute'), icon: () => volIcon(sys.vol ?? 0, sys.muted), on: () => sys.muted, run: () => api.setSystem('mute', 0) },
+    { id: 'coffee', label: () => 'Coffee', icon: () => 'coffee', on: () => LI.state.coffee, run: () => api.run('coffee') },
+    { id: 'textExtract', label: () => 'Text', icon: () => 'textExtract', run: () => { api.run('textExtract'); LI.island.close(); } },
+    { id: 'colorPicker', label: () => 'Color', icon: () => 'colorPicker', run: () => { api.run('colorPicker'); LI.island.close(); } },
+  ];
+  QA.forEach((q) => quick.append(el('button', { class: 'qa-btn', 'data-id': q.id })));
+  function updateQuick() {
+    QA.forEach((q) => {
+      const b = quick.querySelector(`[data-id="${q.id}"]`);
