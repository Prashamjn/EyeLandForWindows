+.pl-card span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.pl-card:hover { background: var(--hover); color: var(--fg); border-color: var(--border-hi); } .pl-card:active { transform: scale(.97); }
+.pl-card.on { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
+
+/* ---------- shared controls ---------- */
+.btn { height: 30px; padding: 0 14px; border-radius: var(--r-ctl); background: var(--press); font-weight: 600; font-size: 12px; transition: filter var(--t-ui), opacity var(--t-ui); }
+.btn:hover { filter: brightness(1.25); }
+.btn.primary { background: var(--fg); color: var(--bg); } .btn.primary:hover { filter: none; opacity: .88; }
+.link-btn { color: var(--muted); font-size: 12px; } .link-btn:hover { color: var(--fg); }
+.empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--muted); text-align: center; padding: 10px; }
+.empty svg { width: 24px; height: 24px; color: var(--faint); }
+.empty .t { color: var(--fg); font-weight: 600; }
+.view-fill { height: 100%; border-radius: var(--r-card); background: var(--card); border: 1px solid var(--border); }
+
+/* ---------- timer ---------- */
+.timer { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; }
+.chips { display: flex; gap: 2px; background: var(--hover); border-radius: 10px; padding: 2px; }
+.chips button { padding: 3px 14px; border-radius: 8px; font-weight: 600; color: var(--muted); font-size: 12px; } .chips button.on { background: var(--fg); color: var(--bg); }
+.timer-big { font: 600 44px/1 var(--font-display); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
+.timer-bar { width: 260px; height: 4px; border-radius: 2px; background: var(--track); overflow: hidden; } .timer-bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .3s linear; }
+.timer-actions { display: flex; gap: 6px; }
+
+/* ---------- clipboard / tasks ---------- */
+.list-head { display: flex; justify-content: space-between; align-items: center; height: 26px; flex: none; }
+.col { display: flex; flex-direction: column; gap: 6px; height: 100%; min-height: 0; }
+.clip-list, .task-list { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; padding-right: 3px; }
+.clip-list button { text-align: left; padding: 7px 11px; border-radius: 10px; border: 1px solid var(--border); background: var(--card); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: none; transition: background var(--t-ui); }
+.clip-list button:hover { background: var(--hover); }
+.task-add { display: flex; gap: 6px; flex: none; }
+.task-add input { flex: 1; height: 30px; border-radius: var(--r-ctl); border: 1px solid var(--border); background: var(--card); color: var(--fg); padding: 0 11px; font: inherit; outline: 0; user-select: text; }
+.task-add input:focus { border-color: var(--border-hi); }
+.task { display: flex; align-items: center; gap: 9px; padding: 6px 9px; border-radius: 10px; border: 1px solid var(--border); background: var(--card); flex: none; }
+.task span { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.task.done span { text-decoration: line-through; color: var(--muted); }
+.task input { accent-color: var(--accent); width: 14px; height: 14px; }
+.task-del { width: 22px; height: 22px; display: grid; place-items: center; color: var(--muted); border-radius: 6px; opacity: 0; transition: opacity var(--t-ui); }
+.task:hover .task-del, .task-del:focus-visible { opacity: 1; } .task-del:hover { background: var(--hover); color: var(--fg); }
+.task-del svg { width: 12px; height: 12px; }
+
+/* ---------- settings ---------- */
+.settings { height: 100%; overflow-y: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; align-content: start; padding: 2px 6px 2px 4px; }
+.field { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 30px; }
+.field label { color: var(--muted); font-weight: 600; white-space: nowrap; font-size: 12px; }
+.field input[type=range] { max-width: 96px; }
+.field select, .field input[type=number] { background: var(--card); color: var(--fg); border: 1px solid var(--border); border-radius: 8px; padding: 3px 7px; font: inherit; font-size: 12px; width: 96px; }
+.field select option { background: #1b1d23; color: #f5f5f7; }
+.field input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--accent); }
+.settings .foot { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; margin-top: 6px; padding-top: 8px; border-top: 1px solid var(--border); }
+.settings .quit { color: var(--danger); font-weight: 600; font-size: 12px; }
