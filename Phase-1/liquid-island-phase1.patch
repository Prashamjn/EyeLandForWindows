+const fs = require('fs'), path = require('path');
+const R = {}; const ok = (name, cond, extra = '') => { R[name] = !!cond; console.log(`[TEST] ${cond ? 'PASS' : 'FAIL'}  ${name}${extra ? '  ' + extra : ''}`); };
+module.exports = async (c) => {
+  const { app } = c; const ud = app.getPath('userData');
