diff --git a/renderer/activity.js b/renderer/activity.js
new file mode 100644
index 0000000..089438d
--- /dev/null
+++ b/renderer/activity.js
@@ -0,0 +1,71 @@
+'use strict';
+// The dynamic activity area. An "activity" is plain data:
+//   { id, kind, icon | color, title, sub?, progress? (0-100), value?, tone? ('success'|'warn'),
+//     mini? ('bar'|'text'|'media'), controls? [{ id, icon, label, primary?, onClick }] }
+// Providers (volume, brightness, media, timer, notices...) only call LI.activity.show() or LI.activity.setBase().
+// Future activity types need no change here or in the dashboard.
+//
+// Selection rule (deliberately simple in Phase 1, no prioritisation engine):
+//   1. the most recent transient activity (volume, brightness, notice...) until its ttl ends,
+//   2. otherwise the first persistent one in BASE_ORDER (media, then focus timer),
+//   3. otherwise a quiet empty state.
+(() => {
+  const { $, iconHtml, clamp } = LI;
+  const root = $('#activity'), tile = $('#actTile'), title = $('#actTitle'), sub = $('#actSub');
+  const track = $('#actTrack'), fill = $('#actFill'), val = $('#actVal'), ctrls = $('#actCtrls');
+
+  const BASE_ORDER = ['media', 'timer'];
+  const EMPTY = { id: 'empty', kind: 'empty', icon: 'inbox', title: 'Nothing happening', sub: 'Volume, media and notifications appear here' };
+  const bases = {};
+  let transient = null, tId = 0, shown = null, sig = '';
+
+  const current = () => transient || BASE_ORDER.map((k) => bases[k]).find(Boolean) || EMPTY;
+
+  function paint() {
+    if (LI.island.state !== 'full') return;          // nothing visible: repainted when the island opens
+    const a = current();
+    const swap = !shown || shown.id !== a.id;
+    shown = a;
+    root.dataset.kind = a.kind || 'notice';
+    root.dataset.tone = a.tone || '';
+    tile.innerHTML = iconHtml(a);
+    title.textContent = a.title || '';
+    sub.textContent = a.sub || ''; sub.hidden = !a.sub;
+    const hasP = typeof a.progress === 'number';
+    track.hidden = !hasP; if (hasP) fill.style.width = clamp(a.progress) + '%';
+    val.textContent = a.value || ''; val.hidden = !a.value;
+
+    const list = a.controls || [];
+    const s = list.map((c) => `${c.id}:${c.icon}:${c.primary ? 1 : 0}`).join('|');
+    if (s !== sig) {                                   // rebuild buttons only when their shape changes
+      sig = s;
+      ctrls.replaceChildren(...list.map((c, i) => {
+        const b = document.createElement('button');
+        b.className = 'act-btn fill' + (c.primary ? ' primary' : '');
+        b.dataset.i = i; b.title = c.label; b.setAttribute('aria-label', c.label);
+        b.innerHTML = LI.icon(c.icon);
+        return b;
+      }));
+    }
+    if (swap) { root.classList.remove('swap'); void root.offsetWidth; root.classList.add('swap'); }
+  }
+  // one delegated listener, resolved against the activity currently on screen
+  ctrls.addEventListener('click', (e) => {
+    const b = e.target.closest('.act-btn'); if (!b || !shown) return;
+    const c = (shown.controls || [])[+b.dataset.i]; if (c && c.onClick) c.onClick();
+  });
+
+  LI.activity = {
+    // transient: shows in the activity area and (unless mini:false) as a mini island while the island is compact
+    show(a, { ttl = 1800, mini = true } = {}) {
+      transient = a; clearTimeout(tId);
+      tId = setTimeout(() => { if (transient === a) { transient = null; paint(); } }, ttl);
+      paint();
+      if (mini) LI.island.mini(a, ttl);
+    },
+    // persistent: stays until replaced or cleared (pass null)
+    setBase(id, a) { bases[id] = a || null; paint(); },
+    refresh: paint,
+    current,
+  };
+})();
diff --git a/renderer/app.js b/renderer/app.js
new file mode 100644
index 0000000..db2b24d
--- /dev/null
+++ b/renderer/app.js
@@ -0,0 +1,79 @@
+'use strict';
+// Entry point: loads settings, then connects every main-process event exactly once.
+(() => {
+  const { $ } = LI;
+
+  /* ---------- settings -> DOM ---------- */
+  LI.applySettings = (prev) => {
+    const S = LI.S;
+    document.body.dataset.theme = S.theme || 'black';
+    document.body.dataset.accent = S.accent || 'blue';
+    document.documentElement.style.setProperty('--speed', S.animSpeed || 1);
+    LI.island.layout();
+    LI.panels.onSettings();
+    LI.dashboard.onSettings(!!prev);
+  };
+
+  /* ---------- main-process events (registered once; the preload bridge has no unsubscribe, so never register twice) ---------- */
+  api.onCursor(LI.island.onCursor);
+  api.onOpenPanel((d) => LI.island.open(d || {}));
+  api.onSystem((m) => LI.dashboard.onSystem(m));
+  api.onClips((list) => LI.panels.onClips(list));
+  api.onSettings((s) => { const prev = LI.S; LI.S = s; LI.applySettings(prev); });
+  api.onCoffee((on) => LI.dashboard.setCoffee(on));
+
+  // plugin results from the main process: { icon, text, color }
+  const TOAST_ICON = { copy: 'copy', check: 'check', warn: 'warn', search: 'lens', coffee: 'coffee' };
+  api.onToast(({ icon, text, color }) => {
+    if (LI.island.state === 'full') LI.island.close();                  // results appear after you act elsewhere on screen
+    LI.activity.show({
+      id: 'notice', kind: 'notice', icon: TOAST_ICON[icon] || 'check', color: icon === 'color' ? color : undefined,
+      title: text, tone: icon === 'warn' ? 'warn' : '', mini: 'text',
+    }, { ttl: Math.max(2200, LI.S.overlayMs || 1800) });
+  });
+
+  /* ---------- media ---------- */
+  const mediaActivity = (m) => ({
+    id: 'media', kind: 'media', icon: 'music', title: m.title, sub: m.artist || m.app || '', mini: 'media',
+    controls: [
+      { id: 'prev', icon: 'prev', label: 'Previous', onClick: () => api.media('prev') },
+      { id: 'play', icon: m.playing ? 'pauseF' : 'play', label: m.playing ? 'Pause' : 'Play', primary: true, onClick: () => api.media('play') },
+      { id: 'next', icon: 'next', label: 'Next', onClick: () => api.media('next') },
+    ],
+  });
+  let mediaSeen = false;
+  api.onMedia((m) => {
+    m = m || {};
+    const prev = LI.state.media; LI.state.media = m;
+    LI.activity.setBase('media', m.title ? mediaActivity(m) : null);
+    // a new track while playing gets a brief mini presentation (never on the very first reading at startup)
+    if (mediaSeen && m.title && m.playing && m.title !== prev.title) LI.island.mini(mediaActivity(m), 3200);
+    mediaSeen = true;
+  });
+
+  /* ---------- battery: small readout in the clock card + a charging notice when the power state changes ---------- */
+  if (navigator.getBattery) navigator.getBattery().then((b) => {
+    LI.dashboard.setBattery(b.level, b.charging);
+    b.addEventListener('levelchange', () => LI.dashboard.setBattery(b.level, b.charging));
+    b.addEventListener('chargingchange', () => {
+      LI.dashboard.setBattery(b.level, b.charging);
+      LI.activity.show({
+        id: 'battery', kind: 'battery', icon: b.charging ? 'batteryCharge' : 'battery', title: b.charging ? 'Charging' : 'On battery',
+        sub: Math.round(b.level * 100) + '%', tone: b.charging ? 'success' : '', mini: 'text',
+      }, { ttl: 2600 });
+    });
+  }).catch(() => {});
+
+  /* ---------- boot ---------- */
+  (async () => {
+    LI.S = await api.getSettings();
+    LI.panels.buildSettings();
+    LI.applySettings();
+    LI.panels.setTimerMode('focus'); LI.panels.paintClips(); LI.panels.paintTasks();
+    LI.dashboard.paintSystem(); LI.dashboard.paintClock(); LI.dashboard.paintWeather();
+    LI.dashboard.show('home');
+    try { LI.dashboard.setCoffee(await window.eyeland.invoke('ey:coffee')); } catch {}
+    LI.dashboard.refreshCatalog();
+    LI.dashboard.loadWeather();
+  })();
+})();
diff --git a/renderer/core.js b/renderer/core.js
new file mode 100644
index 0000000..894fe73
--- /dev/null
+++ b/renderer/core.js
@@ -0,0 +1,34 @@
+'use strict';
+// Shared helpers and state for the island renderer. Everything hangs off one namespace: window.LI.
+(() => {
+  const $ = (s, r = document) => r.querySelector(s);
+  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
+
+  // tiny DOM builder. Text always goes through textContent, so media titles, place names etc. can never inject markup.
+  const el = (tag, props, ...kids) => {
+    const n = document.createElement(tag);
+    for (const [k, v] of Object.entries(props || {})) {
+      if (v == null || v === false) continue;
+      if (k === 'class') n.className = v;
+      else if (k === 'text') n.textContent = v;
+      else if (k === 'html') n.innerHTML = v;            // trusted markup only (our own icons)
+      else n.setAttribute(k, v === true ? '' : v);
+    }
+    kids.flat().forEach((c) => { if (c != null && c !== false) n.append(c.nodeType ? c : document.createTextNode(c)); });
+    return n;
+  };
+
+  const icon = (id) => ICONS.svg(id);
+  const clamp = (v, a = 0, b = 100) => Math.min(b, Math.max(a, v));
+  const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
+  const volIcon = (v, muted) => (muted ? 'volMute' : v <= 0 ? 'vol0' : v <= 50 ? 'vol1' : 'vol2');
+  // colour swatch used as an icon (only accepts a plain hex colour)
+  const swatch = (c) => (/^#[0-9a-f]{3,8}$/i.test(c || '') ? `<i class="swatch" style="background:${c}"></i>` : null);
+  const iconHtml = (a) => (a.color && swatch(a.color)) || icon(a.icon);
+
+  window.LI = {
+    $, $$, el, icon, iconHtml, clamp, debounce, volIcon, swatch,
+    S: {},                                        // settings mirror (replaced whenever settings change)
+    state: { vol: null, muted: false, bri: null, media: { title: '', artist: '', app: '', playing: false }, clips: [], coffee: false },
+  };
+})();
diff --git a/renderer/dashboard.css b/renderer/dashboard.css
new file mode 100644
