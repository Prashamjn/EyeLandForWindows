{
  "name": "eyeland",
  "version": "2.0.0",
  "description": "Liquid Island: a macOS Dynamic Island-inspired island for Windows, with a live dashboard and 20 built-in tools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test:unit": "node --test tools/tests/*.test.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eyeland.app",
    "productName": "Liquid Island",
    "asarUnpack": [
      "native/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "shared/**",
      "renderer/**",
      "overlay/**",
      "native/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
